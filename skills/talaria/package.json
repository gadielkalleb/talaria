{
  "name": "talaria",
  "version": "1.0.0",
  "description": "Talaria — Playwright stealth evasion skill for agents (Hermes, OpenClaw, Cursor, Codex).",
  "type": "module",
  "main": "scripts/index.js",
  "bin": {
    "talaria": "scripts/cli.js"
  },
  "files": [
    "SKILL.md",
    "scripts",
    "test",
    "env.example"
  ],
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "start": "node scripts/cli.js",
    "cli": "node scripts/cli.js",
    "test": "node --test --test-timeout=90000 test/*.e2e.test.js",
    "postinstall": "npx playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
