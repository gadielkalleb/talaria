# Copy to `.env` in this skill directory, then export or load into the process env.
# CLI and launchStealthBrowser read these via process.env (HEADLESS only if headless is omitted).

HEADLESS=true

# Optional proxy (residential IP helps when stealth alone is not enough)
PROXY_SERVER=http://127.0.0.1:8080
PROXY_USERNAME=
PROXY_PASSWORD=
